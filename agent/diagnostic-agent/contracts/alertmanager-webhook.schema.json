{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-lab.local/contracts/alertmanager-webhook.schema.json",
  "title": "Alertmanager Webhook",
  "description": "Alertmanager 发送给只读诊断 Agent 的事件契约。",
  "type": "object",
  "required": [
    "status",
    "alerts"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "groupKey": {
      "type": "string"
    },
    "truncatedAlerts": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "firing",
        "resolved"
      ]
    },
    "receiver": {
      "type": "string"
    },
    "groupLabels": {
      "$ref": "#/$defs/labels"
    },
    "commonLabels": {
      "$ref": "#/$defs/labels"
    },
    "commonAnnotations": {
      "$ref": "#/$defs/labels"
    },
    "externalURL": {
      "type": "string",
      "format": "uri"
    },
    "alerts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/alert"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "alert": {
      "type": "object",
      "required": [
        "status",
        "labels",
        "annotations",
        "startsAt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "firing",
            "resolved"
          ]
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "annotations": {
          "$ref": "#/$defs/labels"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "type": "string",
          "format": "date-time"
        },
        "generatorURL": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
